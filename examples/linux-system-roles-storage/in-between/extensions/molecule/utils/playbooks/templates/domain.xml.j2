{#- Libvirt domain for a storage-role test node. vda is the OS overlay. This
    template is the only place a data disk (utils/vars/disks.yml) meets a
    libvirt bus: every one goes on bus scsi on one virtio-scsi controller, target
    sdX, as standard-inventory-qcow2 attaches provision.fmf's scsi disks. Only the
    scenario's slice, scenario_disks, is attached. Every data disk carries its
    label as a disk <serial>. A port to another hypervisor replaces this
    template, keeps disks.yml and reproduces the labels. Every disk is a native
    libvirt disk, so libvirt applies its SELinux labels to all of them. The
    emulator is left to libvirt's default for the arch. -#}
<domain type='kvm'>
  <name>{{ domain }}</name>
  <memory unit='MiB'>{{ node_memory_mb }}</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <cpu mode='host-passthrough'/>
  <features><acpi/><apic/></features>
  <devices>

    {#- OS disk -#}
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ workdir }}/root.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    {#- cloud-init NoCloud seed -#}
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ workdir }}/seed.iso'/>
      <target dev='sdz' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='scsi' index='0' model='virtio-scsi'/>

    {#- Data disks. The file name is the drive index (matches create.yml
        disk{{ idx }}.raw). -#}
    {%- set sletters = 'abcdefghij' -%}
    {%- for d in scenario_disks %}
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='{{ workdir }}/disk{{ loop.index0 }}.raw'/>
      <target dev='sd{{ sletters[loop.index0] }}' bus='scsi'/>
      <serial>{{ d.label }}</serial>
    </disk>
    {%- endfor %}

    <interface type='network'>
      <source network='{{ libvirt_network }}'/>
      <model type='virtio'/>
    </interface>
    <serial type='pty'><target port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
  </devices>
</domain>
